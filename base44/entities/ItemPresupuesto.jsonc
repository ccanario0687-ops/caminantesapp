{
  "name": "ItemPresupuesto",
  "type": "object",
  "properties": {
    "presupuesto_id": {
      "type": "string",
      "description": "ID del presupuesto al que pertenece este \u00edtem"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Alimentos y Bebidas",
        "Materiales Espirituales",
        "Uniformes y Vestimenta",
        "Log\u00edstica y Transporte",
        "Sonido y Audiovisual",
        "Papeler\u00eda e Imprenta",
        "Decoraci\u00f3n",
        "Tecnolog\u00eda",
        "Miscel\u00e1neos"
      ],
      "description": "Categor\u00eda del \u00edtem"
    },
    "nombre": {
      "type": "string",
      "description": "Nombre del \u00edtem (ej: Biblia, Agua 5L, Gafetes)"
    },
    "unidad": {
      "type": "string",
      "description": "Unidad de medida (ej: unidad, caja, gal\u00f3n, kg)",
      "default": "unidad"
    },
    "cantidad_presupuestada": {
      "type": "number",
      "description": "Cantidad planificada necesaria",
      "default": 0
    },
    "cantidad_en_existencia": {
      "type": "number",
      "description": "Cantidad que ya se tiene disponible",
      "default": 0
    },
    "costo_unitario": {
      "type": "number",
      "description": "Costo estimado por unidad (RD$)",
      "default": 0
    },
    "suplidor_nombre": {
      "type": "string",
      "description": "Nombre del suplidor sugerido para este \u00edtem"
    },
    "prioridad": {
      "type": "string",
      "enum": [
        "Alta",
        "Media",
        "Baja"
      ],
      "default": "Media",
      "description": "Prioridad del \u00edtem"
    },
    "completado": {
      "type": "boolean",
      "default": false,
      "description": "Indica si el \u00edtem ya fue adquirido/completado"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales del \u00edtem"
    },
    "equipo_id": {
      "type": "string",
      "description": "ID del equipo al que pertenece este registro"
    }
  },
  "required": [
    "nombre",
    "presupuesto_id",
    "categoria"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.equipo_id": "{{user.data.equipo_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.equipo_id": "{{user.data.equipo_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.equipo_id": "{{user.data.equipo_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.equipo_id": "{{user.data.equipo_id}}"
        }
      ]
    }
  }
}